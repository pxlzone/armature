{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://armature.local/armature.schema.json",
  "title": "Armature model files",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "strings": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "kind": {
      "enum": [
        "actor",
        "app",
        "service",
        "worker",
        "job",
        "agent",
        "store",
        "queue",
        "external",
        "library",
        "group",
        "platform"
      ]
    },
    "interface": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "via": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "queue": {
          "type": "string"
        },
        "takes": {
          "$ref": "#/$defs/strings"
        },
        "gives": {
          "$ref": "#/$defs/strings"
        },
        "dlq": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "retire": {
          "type": "string"
        }
      }
    },
    "held": {
      "oneOf": [
        {
          "$ref": "#/$defs/slug"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "shape": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "change": {
              "type": "string"
            },
            "retire": {
              "type": "string"
            }
          }
        }
      ]
    },
    "link": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "to": {
              "type": "string"
            },
            "via": {
              "type": "string"
            },
            "takes": {
              "$ref": "#/$defs/strings"
            },
            "gives": {
              "$ref": "#/$defs/strings"
            },
            "shape": {
              "$ref": "#/$defs/strings"
            },
            "note": {
              "type": "string"
            },
            "change": {
              "type": "string"
            },
            "retire": {
              "type": "string"
            }
          }
        }
      ]
    },
    "rule": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "todo": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "task",
                "debt",
                "bug",
                "idea"
              ]
            },
            "priority": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "owner": {
              "type": "string"
            },
            "issue": {
              "type": "integer"
            },
            "change": {
              "type": "string"
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "text": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "tests": {
          "$ref": "#/$defs/strings"
        },
        "match": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "tech": {
          "$ref": "#/$defs/strings"
        },
        "hub": {
          "type": "boolean"
        },
        "color": {
          "enum": [
            "green",
            "blue",
            "teal",
            "purple",
            "pink",
            "orange",
            "gray"
          ]
        },
        "image": {
          "type": "string"
        },
        "scopes": {
          "$ref": "#/$defs/strings"
        },
        "docs": {
          "$ref": "#/$defs/strings"
        },
        "code": {
          "$ref": "#/$defs/strings"
        },
        "tests": {
          "$ref": "#/$defs/strings"
        },
        "accepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "holds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/held"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "sends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "todos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/todo"
          }
        },
        "change": {
          "type": "string"
        },
        "retire": {
          "type": "string"
        },
        "unused": {
          "type": "boolean",
          "description": "Dead code: nothing reaches it. Drawn grey with no links."
        },
        "deploy": {
          "$ref": "#/$defs/strings",
          "description": "Compose service names this node runs as."
        },
        "entry": {
          "$ref": "#/$defs/strings",
          "description": "Files started by hand or by tooling that the reachability scan cannot see."
        },
        "shared": {
          "type": "boolean",
          "description": "Libraries only. false marks a domain's own part (a rendering engine, a pricing package), which stays on the map when shared libraries are hidden. Inherited by children."
        }
      }
    },
    "inlineNode": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "required": [
            "id",
            "role"
          ]
        }
      ]
    },
    "system": {
      "type": "object",
      "required": [
        "name",
        "headline"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "budget": {
          "type": "integer",
          "minimum": 3
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inlineNode"
          }
        },
        "externals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inlineNode"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "reports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "junit": {
              "$ref": "#/$defs/strings"
            },
            "lcov": {
              "$ref": "#/$defs/strings"
            }
          }
        },
        "activity_days": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "$ref": "#/$defs/strings"
        },
        "ignore": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "path",
                  "why"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "entry": {
          "$ref": "#/$defs/strings"
        },
        "compose": {
          "$ref": "#/$defs/strings",
          "description": "Compose files to read. Default: every docker-compose*.yml and compose*.yml in the repo."
        },
        "gate": {
          "enum": [
            "on",
            "off"
          ],
          "description": "The planning gate for coding agents: new source files need a node, planned nodes need an approved change, and a plan must say how it changes the model. Default: on."
        },
        "docs": {
          "type": "string",
          "description": "The folder that holds the documents, relative to the repo. Every Markdown file in it needs a kind. Default: docs inside the model folder (armature/docs)."
        }
      }
    },
    "shapes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "required": [
        "headline",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "step"
                ],
                "additionalProperties": false,
                "properties": {
                  "step": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "change": {
      "type": "object",
      "required": [
        "title",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "enum": [
            "proposed",
            "approved",
            "done",
            "dropped"
          ]
        },
        "order": {
          "type": "number"
        },
        "doc": {
          "type": "string"
        },
        "issue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "why": {
          "type": "string"
        },
        "done_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tech": {
      "type": "object",
      "required": [
        "tech"
      ],
      "additionalProperties": false,
      "properties": {
        "tech": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "category"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_.-]*$"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "runtime",
                  "framework",
                  "library",
                  "database",
                  "messaging",
                  "ai",
                  "protocol",
                  "tool",
                  "platform"
                ]
              },
              "url": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "files": {
                "$ref": "#/$defs/strings"
              }
            }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "description": "The header of a Markdown document that belongs to the model. Other keys are allowed.",
      "properties": {
        "kind": {
          "enum": [
            "plan",
            "decision",
            "guide",
            "runbook",
            "review",
            "research",
            "note"
          ]
        },
        "about": {
          "$ref": "#/$defs/strings",
          "description": "References to what the document is about: a node, node#interface, Shape, node:requirement, flow or change."
        },
        "change": {
          "$ref": "#/$defs/strings",
          "description": "The change or changes this document is the plan of."
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
